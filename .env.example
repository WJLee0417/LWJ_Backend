# Copy these names to your operating system environment before running the application.
# This file is documentation only; the application reads OS environment variables, not .env files.
DB_URL=jdbc:mysql://localhost:3306/backend_master?serverTimezone=Asia/Seoul
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
# Optional: creates the admin account on application startup when it does not exist.
ADMIN_INITIAL_PASSWORD=choose_a_strong_development_password
